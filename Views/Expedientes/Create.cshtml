@model ColegioSanJose.Models.Expediente

@{
    ViewData["Title"] = "Agregar Expediente";
}

<h2>Agregar Expediente</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="AlumnoId">Alumno</label>
        <select asp-for="AlumnoId" class="form-control" asp-items="ViewBag.AlumnoId">
            <option value="0">-- Seleccione un Alumno --</option>
        </select>
        <span asp-validation-for="AlumnoId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="MateriaId">Materia</label>
        <select asp-for="MateriaId" class="form-control" asp-items="ViewBag.MateriaId">
            <option value="0">-- Seleccione una Materia --</option>
        </select>
        <span asp-validation-for="MateriaId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="NotaFinal">Nota Final</label>
        <input asp-for="NotaFinal" class="form-control" type="number" step="0.1" min="0" max="10" />
        <span asp-validation-for="NotaFinal" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Observaciones">Observaciones</label>
        <textarea asp-for="Observaciones" class="form-control"></textarea>
    </div>
    <div class="mt-3">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}