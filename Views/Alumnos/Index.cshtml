@model IEnumerable<ColegioSanJose.Models.Alumno>

@{
    ViewData["Title"] = "Alumnos";
}

<h2>Lista de Alumnos</h2>

<p>
    <a asp-action="Create" class="btn btn-lg" style="background-color:#16A34A; color:white;">Agregar Nuevo Alumno</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Fecha Nacimiento</th>
            <th>Grado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.FechaNacimiento.ToShortDateString()</td>
                <td>@item.Grado</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AlumnoId" class="btn btn-sm" style="background-color:#16A34A; color:white;">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.AlumnoId" class="btn btn-sm" style="background-color:#6B7280; color:white;">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.AlumnoId" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>