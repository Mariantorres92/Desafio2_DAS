@model ColegioSanJose.Models.Materia

@{
    ViewData["Title"] = "Eliminar Materia";
}

<h2>Eliminar Materia</h2>

<p>¿Estás segura que deseas eliminar esta materia?</p>

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre Materia</dt>
        <dd class="col-sm-10">@Model.NombreMateria</dd>

        <dt class="col-sm-2">Docente</dt>
        <dd class="col-sm-10">@Model.Docente</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="MateriaId" />
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>