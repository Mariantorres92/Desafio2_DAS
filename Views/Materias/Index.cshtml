@model IEnumerable<ColegioSanJose.Models.Materia>

@{
    ViewData["Title"] = "Materias";
}

<h2>Lista de Materias</h2>

<p>
    <a asp-action="Create" class="btn btn-lg" style="background-color:#16A34A; color:white;">Agregar Nueva Materia</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre Materia</th>
            <th>Docente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreMateria</td>
                <td>@item.Docente</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MateriaId" class="btn btn-sm" style="background-color:#16A34A; color:white;">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.MateriaId" class="btn btn-sm" style="background-color:#6B7280; color:white;">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.MateriaId" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>