@model ColegioSanJose.Models.Materia

@{
    ViewData["Title"] = "Agregar Materia";
}

<h2>Agregar Materia</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="NombreMateria">Nombre de Materia</label>
        <input asp-for="NombreMateria" class="form-control" />
        <span asp-validation-for="NombreMateria" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Docente">Docente</label>
        <input asp-for="Docente" class="form-control" />
        <span asp-validation-for="Docente" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>